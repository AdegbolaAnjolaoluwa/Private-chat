# Frontend build-time config (Vite). Copy to .env.local and set for local dev
# against a deployed backend, or leave unset to default to http://localhost:4000.
VITE_API_URL=https://your-app.onrender.com

# Backend (server/). Render injects DATABASE_URL automatically when a Postgres
# instance is linked to the web service. For local dev, point this at a local
# Postgres database, e.g.:
DATABASE_URL=postgres://localhost:5432/private_chat_dev

# Render assigns PORT automatically; only needed for local dev if you want a
# non-default port.
PORT=4000
